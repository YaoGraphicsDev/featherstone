namespace SPD {

using namespace Eigen;

std::shared_ptr<RigidWorld::Collider> RigidWorld::Collider::create(const RigidBody& rigidbody, int user_id) {
	btCollisionShape* shape = nullptr;
	if (rigidbody.shape->type == Shape::Type::Cuboid) {
		const Cuboid* box = static_cast<Cuboid*>(rigidbody.shape.get());
		shape = new btBoxShape(btv3(box->half_dims));
	}
	else {
		assert(false);
	}

	btCollisionObject* obj = new btCollisionObject();
	obj->setCollisionShape(shape);
	btTransform transform(
		btquat(rigidbody.rotation),
		btv3(rigidbody.translation));
	obj->setWorldTransform(transform);
	obj->setUserIndex(user_id);

	std::shared_ptr<Collider> collider = std::make_shared<Collider>();
	collider->shape.reset(shape);
	collider->obj.reset(obj);
	return collider;
}

void RigidWorld::Collider::update(Eigen::Vector3f translation, Eigen::Quaternionf rotation) {
	btTransform transform(
		btquat(rotation),
		btv3(translation));
	obj->setWorldTransform(transform);
}

RigidWorld::RigidWorld(Eigen::Vector3f gravity) {
	this->gravity = gravity;

	btDefaultCollisionConfiguration* config = new btDefaultCollisionConfiguration();
	btCollisionDispatcher* dispatcher = new btCollisionDispatcher(config );
	btDbvtBroadphase* broadphase = new btDbvtBroadphase();
	btCollisionWorld* world = new btCollisionWorld(dispatcher, broadphase, config);

	collision_world.reset(new CollisionWorld);
	collision_world->config.reset(config);
	collision_world->dispatcher.reset(dispatcher);
	collision_world->broadphase.reset(broadphase);
	collision_world->world.reset(world);
	gContactDestroyedCallback = destroy_persistent_data_cb;
}

RigidWorld::~RigidWorld() {
	for (auto c : colliders) {
		collision_world->world->removeCollisionObject(c->obj.get());
	}
	gContactDestroyedCallback = nullptr;
	collision_world->world.reset();
	collision_world->broadphase.reset();
	collision_world->dispatcher.reset();
	collision_world->config.reset();
}

void RigidWorld::add_body(std::shared_ptr<RigidBody> body) {
	if (!body->shape || body->shape->type == Shape::Type::Default) {
		return;
	}

	bodies.push_back(body);
	std::shared_ptr<Collider> c = Collider::create(*body, bodies.size() - 1);
	colliders.push_back(c);
	collision_world->world->addCollisionObject(c->obj.get());

	collider_body_map[colliders.back()->obj.get()] = bodies.size() - 1;
}

void RigidWorld::step(float dt) {
	collide();
	integrate_velocity(dt);

	for (uint32_t i = 0; i < max_velocity_solve_iterations; ++i) {
		solve_velocity_constraints(i);
	}

	integrate_position(dt);

	for (uint32_t i = 0; i < max_position_solve_iterations; ++i) {
		solve_position_constraints();
	}
}

// parameters in world space
static FVector force_on_com(Vector3f f, Vector3f fp, Vector3f com, Matrix3f com_bases) {
	//Vector3f n = f.cross(-fp);
	//FVector f6;
	//f6 << n, f;
	//FTransform t = dual_transform(m_transform(Matrix3f::Identity(), com_bases, com));
	//f6 = t * f6;
	//return f6;

	Vector3f torque = f.cross(com - fp);
	torque = com_bases.inverse() * torque;
	Vector3f force = com_bases.inverse() * f;

	FTransform t = dual_transform(m_transform(Matrix3f::Identity(), com_bases, com - fp));
	FVector f6;
	f6 << Vector3f::Zero(), f;
	f6 = t * f6;
	//// temp
	//f6.head<3>() = Vector3f::Zero();
 	return f6;
}

void RigidWorld::collide() {
	for (int i = 0; i < bodies.size(); ++i) {
		RigidBody& b = *bodies[i];
		Collider& c = *colliders[i];
		if (b.type == RigidBody::DynamicType::Static) {
			continue;
		}
		c.update(b.translation, b.rotation);
		collision_world->world->updateSingleAabb(c.obj.get());
	}

	collision_world->world->performDiscreteCollisionDetection();
}

void RigidWorld::integrate_velocity(float dt) {
	for (auto b : bodies) {
		if (b->type == RigidBody::DynamicType::Static) {
			continue;
		}

		FVector g6;
		g6 << Vector3f::Zero(), gravity;
		// g6 = dual_transform(m_transform(Matrix3f::Identity(), b->bases, Vector3f::Zero())) * g6;
		FVector fe_com = b->fe + g6 * b->mass;
		b->fe = FVector::Zero();

		MTransform Xr = m_transform(Matrix3f::Identity(), b->rotation.toRotationMatrix(), Vector3f::Zero()); // a rotation to accomodate inertia's rotation
		Dyad I = transform_dyad2(Xr, b->shape->sp_Ic);
		// FVector bias = dual_transform(derivative_cross(b->v)) * (b->mass * b->shape->sp_Ic) * b->v;
		FVector bias = dual_transform(derivative_cross(b->v)) * (b->mass * I) * b->v;
		MVector a = transform_inv_dyad2(Xr, b->shape->sp_inv_Ic) * b->inv_mass * (fe_com - bias);
		// MTransform X_ortho = m_transform(b->bases, Matrix3f::Identity(), Vector3f::Zero());
		MVector v_ortho = /*X_ortho */ b->v;
		MVector a_ortho = /*X_ortho */ a;

		Vector3f v_ang = v_ortho.head<3>();
		Vector3f v_linear = v_ortho.tail<3>();
		Vector3f a_ang = a_ortho.head<3>();
		Vector3f a_linear = a_ortho.tail<3>() + cross_mat(v_ang) * v_linear;

		// implicit euler on ortho linear velocity
		v_linear += a_linear * dt;
		v_linear *= std::pow(1.0f - b->linear_damping, dt); // linear damping

		// implicit euler on ortho angular velocity
		v_ang += a_ang * dt;
		v_ang *= std::pow(1.0f - b->angular_damping, dt); // angular damping

		v_ortho << v_ang, v_linear;
		b->v = /*inverse_transform(X_ortho) */ v_ortho;
	}
}

RigidWorld::ContactPersistentData::Status RigidWorld::ContactPersistentData::status(const btManifoldPoint& cp, uint32_t iter) {
	if (cp.getLifeTime() == 1) {
		// 1. this is a new point found at this STEP
		if (iter == 0) {
			assert(!cp.m_userPersistentData);
			// 1.1 the first velocity constraint ITERATION of a new contact point
			// initialize everything
			return Status::NewContactFirstIter;
		}
		else {
			// 1.2 the new contact point going through velocity constraint ITERATIONs
			return Status::NewContactMultipleIter;
		}
	}
	else {
		// 2. old contact point persisted across STEPs
		ContactPersistentData* cp_data = static_cast<ContactPersistentData*>(cp.m_userPersistentData);
		assert(cp_data);
		if (iter == 0) {
			// 2.1 the first velocity constraint ITERATION of this old contact point
			return Status::PersistedContactFirstIter;
		}
		else {
			// 2.2 old contact point going through velocity constraint ITERATIONs
			return Status::PersistedContactMultipleIter;
		}
	}
}

void RigidWorld::initialize_velocity_constraints() {

}

void RigidWorld::solve_velocity_constraints(uint32_t iter) {
	int n_man = collision_world->dispatcher->getNumManifolds();
	if (n_man == 0) {
		return;
	}
	for (int m = 0; m < n_man; ++m) {
		btPersistentManifold* manifold = collision_world->dispatcher->getManifoldByIndexInternal(m);
		const btCollisionObject* obj0 = manifold->getBody0();
		const btCollisionObject* obj1 = manifold->getBody1();

		size_t id0 = collider_body_map.at(obj0);
		size_t id1 = collider_body_map.at(obj1);
		RigidBody& b0 = *bodies.at(id0);
		RigidBody& b1 = *bodies.at(id1);
		Collider& c0 = *colliders.at(id0);
		Collider& c1 = *colliders.at(id1);
		for (int m = 0; m < manifold->getNumContacts(); ++m) {
			// std::cout << "\tsolve contact point " << c << std::endl;
			btManifoldPoint& cp = manifold->getContactPoint(m);

			float penetration = cp.getDistance();
			if (penetration > 0.0f) {
				// TODO: this shit occasionally happens
				int a = 0;
			}
			btVector3 p = (cp.m_positionWorldOnA + cp.m_positionWorldOnB) * 0.5f;
			btVector3 n = -cp.m_normalWorldOnB;  // normal points from body A (0) to body B (1)
			FVector n6;
			n6 << Vector3f::Zero(), EV3(n).normalized();

			MTransform Xv_0_c = m_transform(Matrix3f::Identity(), Matrix3f::Identity(), EV3(p) - b0.translation); // transform from body 0 to contact point
			MTransform Xv_1_c = m_transform(Matrix3f::Identity(), Matrix3f::Identity(), EV3(p) - b1.translation); // transform from body 1 to contact point
			MVector v0 = Xv_0_c * b0.v;
			MVector v1 = Xv_1_c * b1.v;
			MVector v_01 = v1 - v0;
			float v_01_n = n6.dot(v_01);

			ContactPersistentData::Status status = ContactPersistentData::status(cp, iter);
			if (status == ContactPersistentData::Status::NewContactFirstIter) {
				
			}

			if (cp.getLifeTime() == 1) {
				// 1. this is a new point found at this STEP
				if (iter == 0) {
					assert(!cp.m_userPersistentData);
					// 1.1 the first velocity constraint ITERATION of a new contact point
					// initialize everything
					ContactPersistentData* cp_data = new ContactPersistentData();
					cp.m_userPersistentData = cp_data;
					cp_data->resitution_coeff = std::min(b0.restitution_coeff, b1.restitution_coeff);
					cp_data->resitution_coeff = 0.8f; // TODO: temporary restitution test
					cp_data->friction_coeff = std::sqrt(b0.friction_coeff * b1.friction_coeff);
					cp_data->si_n = 0.0f;
					if (v_01_n < -1.0f) {
						cp_data->bias_v_n = v_01_n * cp_data->resitution_coeff;
					}
					else {
						cp_data->bias_v_n = 0.0f;
					}
				}
				else {
					// 1.2 the new contact point going through velocity constraint ITERATIONs
					// si_n and bias_v_n persists.
					// do nothing
				}
			}
			else {
				// 2. old contact point persisted across STEPs
				ContactPersistentData* cp_data = static_cast<ContactPersistentData*>(cp.m_userPersistentData);
				assert(cp_data);
				if (iter == 0) {
					// 2.1 the first velocity constraint ITERATION of this old contact point
					// update bias velocity
					ContactPersistentData* cp_data = static_cast<ContactPersistentData*>(cp.m_userPersistentData);
					// cp_data->bias_v_n = n6.dot(v_01) * cp_data->resitution_coeff;
					if (v_01_n < -1.0f) {
						cp_data->bias_v_n = v_01_n * cp_data->resitution_coeff;
					}
					else {
						cp_data->bias_v_n = 0.0f;
					}
				}
				else {
					// 2.2 old contact point going through velocity constraint ITERATIONs
					// si_n and bias_v_n persists.
					// do nothing
				}

			}

			ContactPersistentData* cp_data = static_cast<ContactPersistentData*>(cp.m_userPersistentData);
			assert(cp_data);

			// perform impulse calculation in point of impact space
			float e = cp_data->resitution_coeff;
			float mu = cp_data->friction_coeff;
			float& si_n = cp_data->si_n;
			float bias_v_n = cp_data->bias_v_n;
			// std::cout << "\t\tv_01 = " << v_01.tail<3>().transpose() << std::endl;
			MTransform XI_c_0 = m_transform(Matrix3f::Identity(), b0.rotation.toRotationMatrix(), b0.translation - EV3(p));
			MTransform XI_c_1 = m_transform(Matrix3f::Identity(), b1.rotation.toRotationMatrix(), b1.translation - EV3(p));
			InvDyad inv_I0 = b0.type == RigidBody::DynamicType::Static ? InvDyad::Zero() : transform_inv_dyad2(XI_c_0, b0.shape->sp_inv_Ic);
			InvDyad inv_I1 = b1.type == RigidBody::DynamicType::Static ? InvDyad::Zero() : transform_inv_dyad2(XI_c_1, b1.shape->sp_inv_Ic);
			inv_I0 *= b0.inv_mass;
			inv_I1 *= b1.inv_mass;
			// float zeta_n = n6.dot(v_01);
			// Vector3f t = v_01.tail<3>() - n6.tail<3>() * zeta_n;
			// std::cout << "\t\tt = " << t.transpose() << std::endl;
			// TODO: ignore friction for now
			// if (t.norm() < 1e-5) {
			if (true) {
				// no tangential velocity difference, fall back to 1d contact resolution, restitution only
				// TODO: temporary, Baumgarte stabilization
				// float lambda = -((1.0f + e) * n6.dot(v_01) /* + 15.0f * penetration*/) / n6.dot((inv_I0 + inv_I1) * n6);
				float lambda = -(n6.dot(v_01) + bias_v_n /* + 15.0f * penetration*/) / n6.dot((inv_I0 + inv_I1) * n6);
				// sequential impulse
				float new_impulse = std::max(si_n + lambda, 0.0f);
				lambda = new_impulse - si_n;
				// std::cout << lambda << std::endl;
				si_n = new_impulse;

				FVector imp_01 = lambda * n6; // impulse pointing from 0 to 1
				if (b0.type == RigidBody::DynamicType::Dynamic) {
					MVector dv = inverse_transform(Xv_0_c) * (-inv_I0 * imp_01);
 					b0.v += dv;
				}
 				if (b1.type == RigidBody::DynamicType::Dynamic) {
					MVector dv = inverse_transform(Xv_1_c) * (inv_I1 * imp_01);
					b1.v += dv;
				}
			}
			//else {
			//	MVector t6;
			//	t6 << Vector3f::Zero(), t.normalized();
			//	FSubspace N(6, 2);
			//	N.col(0) = t6;
			//	N.col(1) = n6;
			//	Matrix2f E = Matrix2f::Zero();
			//	E(1, 1) = e;
			//	Vector2f B(0.0f, 15.0f * penetration); // Baumgarte term, TODO: temporary value
			//	Vector2f lambda = -(N.transpose() * (inv_I0 + inv_I1) * N).inverse() * ((Matrix<float, 2, 2>::Identity() + E) * N.transpose() * v_01 + B);//  / n6.dot((inv_I0 + inv_I1) * n6);
			//	float max_tangent = std::abs(lambda(1)) * mu;
			//	lambda(0) = std::clamp(lambda(0), -max_tangent, max_tangent);
			//	FVector imp_01 = N * lambda; // impulse pointing from 0 to 1
			//	if (b0.type == RigidBody::DynamicType::Dynamic) {
			//		MVector dv = inverse_transform(X_0_c) * (-inv_I0 * imp_01);
			//		b0.v += dv;
			//	}
			//	if (b1.type == RigidBody::DynamicType::Dynamic) {
			//		MVector dv = inverse_transform(X_1_c) * (inv_I1 * imp_01);
			//		b1.v += dv;
			//	}
			//}


			// restitution only
			//float e = std::min(b0.restitution_coeff, b1.restitution_coeff);
			//float mu = std::sqrt(b0.friction_coeff * b1.friction_coeff);
			//FVector n6;
			//n6 << Vector3f::Zero(), EV3(n).normalized();
			//MTransform X_0_c = m_transform(Matrix3f::Identity(), Matrix3f::Identity(), EV3(p0) - b0.translation); // transform from body 0 to contact point
			//MTransform X_1_c = m_transform(Matrix3f::Identity(), Matrix3f::Identity(), EV3(p1) - b1.translation); // transform from body 1 to contact point
			//MVector v0 = X_0_c * b0.v;
			//MVector v1 = X_1_c * b1.v;
			//InvDyad inv_I0 = b0.type == RigidBody::DynamicType::Static ? InvDyad::Zero() : transform_inv_dyad(X_0_c, b0.shape->sp_inv_Ic);
			//InvDyad inv_I1 = b1.type == RigidBody::DynamicType::Static ? InvDyad::Zero() : transform_inv_dyad(X_1_c, b1.shape->sp_inv_Ic);
			//// TODO: temporary, Baumgarte stabilization
			//float lambda = -((1 + e) * n6.dot(v1 - v0) + 15.0f * penetration) / n6.dot((inv_I0 + inv_I1) * n6);
			//FVector imp_01 = lambda * n6; // impulse pointing from 0 to 1
			//MVector dv0 = inverse_transform(X_0_c) * (-inv_I0 * imp_01);
			//MVector dv1 = inverse_transform(X_1_c) * (inv_I1 * imp_01);
			//b0.v += dv0;
			//b1.v += dv1;

			// compliant contact model, normal separation force only
			//float z = std::max(-penetration, 0.0f);
			//float dz = n6.dot(v0 - v1);
			//float K = 100.0f;
			//float D = 80.0f;
			//float f = K * std::pow(z, 1.5f) + D * std::pow(z, 0.5f) * dz;
			//if (std::isnan(f)) {
			//	std::cout << "f nan" << std::endl;
			//}
			//std::cout << f << std::endl;
			//f = std::max(f, 0.0f);
		}
	}
}

void RigidWorld::integrate_position(float dt) {
	// TODO: for an accurate integration, see line 1103 of btDiscretePhysicsWorld.cpp predictIntegratedTransform
	for (auto b : bodies) {
		// implicit euler on ortho linear velocity
		Vector3f v_linear = b->v.tail<3>();
		b->translation += v_linear * dt;

		// implicit euler on ortho angular velocity
		Vector3f v_ang = b->v.head<3>();
		Quaternionf q = b->rotation;
		Quaternionf dq = q * Quaternionf(0.0f, v_ang.x(), v_ang.y(), v_ang.z());
		dq.coeffs() *= 0.5f;
		Quaternionf dqdt;
		dqdt.coeffs() = dq.coeffs() * dt;
		q.coeffs() = q.coeffs() + dqdt.coeffs();
		b->rotation = q;
		b->rotation.normalize();
	}
}

// return a negative value if penetration happens
float RigidWorld::new_penetration(
	const RigidBody& b0, Vector3f local_p0,
	const RigidBody& b1, Vector3f local_p1,
	Vector3f n_01) {
	Vector3f p0 = b0.rotation.toRotationMatrix() * local_p0 + b0.translation;
	Vector3f p1 = b1.rotation.toRotationMatrix() * local_p1 + b1.translation;
	float proj = n_01.dot((p0 - p1));
	return -proj;
}

Eigen::Vector3f RigidWorld::find_penetration(const btCollisionObject* obj0, const btCollisionObject* obj1) {
	//btCollisionObjectWrapper obj0_wrap(nullptr, obj0->getCollisionShape(), obj0, obj0->getWorldTransform(), -1, -1);
	//btCollisionObjectWrapper obj1_wrap(nullptr, obj1->getCollisionShape(), obj1, obj1->getWorldTransform(), -1, -1);
	//// Get the collision algorithm for this pair
	//btCollisionAlgorithm* algo = collision_world->dispatcher->findAlgorithm(&obj0_wrap, &obj1_wrap, nullptr, BT_CONTACT_POINT_ALGORITHMS);
	//assert(algo);
	//// Create temporary manifold storage
	//btManifoldResult manifold_result(&obj0_wrap, &obj1_wrap);
	//btDispatcherInfo dispatchInfo;
	//dispatchInfo.m_dispatchFunc = btDispatcherInfo::DISPATCH_DISCRETE;
	////dispatchInfo.m_timeOfImpact = 1.0f;
	//dispatchInfo.m_useContinuous = false;
	////dispatchInfo.m_debugDraw = nullptr;
	////dispatchInfo.m_enableSatConvex = false;
	////dispatchInfo.m_enableSPU = true;
	////dispatchInfo.m_useEpa = true;
	//dispatchInfo.m_allowedCcdPenetration = 0.0f;
	//// Perform full narrowphase collision detection
	//algo->processCollision(&obj0_wrap, &obj1_wrap, dispatchInfo, &manifold_result);
	//btPersistentManifold* manifold = manifold_result.getPersistentManifold();

	btGjkEpaPenetrationDepthSolver epaSolver;
	btVoronoiSimplexSolver simplexSolver;

	const btConvexShape* convex0 = nullptr;
	const btConvexShape* convex1 = nullptr;
	const btCollisionShape* shape0 = obj0->getCollisionShape();
	const btCollisionShape* shape1 = obj1->getCollisionShape();
	if (shape0->isConvex()) {
		convex0 = static_cast<const btConvexShape*>(shape0);
	}
	else {
		assert(false);
		return Vector3f::Zero();
	}
	if (shape1->isConvex()) {
		convex1 = static_cast<const btConvexShape*>(shape1);
	}
	else {
		assert(false);
		return Vector3f::Zero();
	}

	if (!convex0 || !convex1) {
		// One or both shapes are not convex
		assert(false);
		return Vector3f::Zero();
	}
	const btTransform& transform0 = obj0->getWorldTransform();
	const btTransform& transform1 = obj1->getWorldTransform();

	btVector3 penetration_vec;
	btVector3 witness0, witness1;

	if (epaSolver.calcPenDepth(
		simplexSolver, convex0, convex1,
		transform0, transform1,
		penetration_vec, witness0, witness1, nullptr)) {
		Vector3f vec = EV3(witness0) - EV3(witness1); // TODO: is this a good direction to solve penetration? probably not
		return vec;
	}
	else {
		return Vector3f::Zero();
	}
}

void RigidWorld::solve_position_constraints() {
	int n_man = collision_world->dispatcher->getNumManifolds();
	if (n_man == 0) {
		return;
	}

	for (int m = 0; m < n_man; ++m) {
		btPersistentManifold* manifold = collision_world->dispatcher->getManifoldByIndexInternal(m);
		const btCollisionObject* obj0 = manifold->getBody0();
		const btCollisionObject* obj1 = manifold->getBody1();
		size_t id0 = collider_body_map.at(obj0);
		size_t id1 = collider_body_map.at(obj1);
		RigidBody& b0 = *bodies.at(id0);
		RigidBody& b1 = *bodies.at(id1);

		for (int m = 0; m < manifold->getNumContacts(); ++m) {
			btManifoldPoint& cp = manifold->getContactPoint(m);
			Vector3f p0 = b0.rotation.toRotationMatrix() * EV3(cp.m_localPointA) + b0.translation;
			Vector3f p1 = b1.rotation.toRotationMatrix() * EV3(cp.m_localPointB) + b1.translation;
			Vector3f p = (p0 + p1) * 0.5f;
			Vector3f n = EV3(-cp.m_normalWorldOnB);  // normal points from body A (0) to body B (1)
			float penetration = n.dot(p1 - p0); // negative when penetration happens
			// Track max constraint error.
			penetration = std::min(0.0f, penetration);
			// Prevent large corrections and allow slop.
			const float baumgarte = 0.1f;
			const float slop = 0.005f;
			const float max_correction = 0.2f;
			penetration = std::clamp(baumgarte * (penetration + slop), -max_correction, 0.0f);

			MVector n6;
			n6 << Vector3f::Zero(), n.normalized();

			//MTransform XI_c_0 = m_transform(Matrix3f::Identity(), b0.rotation.toRotationMatrix(), b0.translation - EV3(p));
			//MTransform XI_c_1 = m_transform(Matrix3f::Identity(), b1.rotation.toRotationMatrix(), b1.translation - EV3(p));
			//InvDyad inv_I0 = b0.type == RigidBody::DynamicType::Static ? InvDyad::Zero() : transform_inv_dyad2(XI_c_0, b0.shape->sp_inv_Ic);
			//InvDyad inv_I1 = b1.type == RigidBody::DynamicType::Static ? InvDyad::Zero() : transform_inv_dyad2(XI_c_1, b1.shape->sp_inv_Ic);

			MTransform XI_c_0 = m_transform(Matrix3f::Identity(), b0.rotation.toRotationMatrix(), b0.translation - p); // transform from contact point to body 0
			MTransform XI_c_1 = m_transform(Matrix3f::Identity(), b1.rotation.toRotationMatrix(), b1.translation - p); // transform from contact point to body 1
			InvDyad inv_I0 = b0.type == RigidBody::DynamicType::Static ? InvDyad::Zero() : transform_inv_dyad2(XI_c_0, b0.shape->sp_inv_Ic);
			InvDyad inv_I1 = b1.type == RigidBody::DynamicType::Static ? InvDyad::Zero() : transform_inv_dyad2(XI_c_1, b1.shape->sp_inv_Ic);

			// positional impulse
			float lambda = -(penetration) / n6.dot((inv_I0 + inv_I1) * n6);
			MVector imp_01 = lambda * n6; // impulse pointing from 0 to 1

			MTransform Xv_0_c = m_transform(Matrix3f::Identity(), Matrix3f::Identity(), p - b0.translation); // transform from body 0 to contact point
			MTransform Xv_1_c = m_transform(Matrix3f::Identity(), Matrix3f::Identity(), p - b1.translation); // transform from body 1 to contact point

			if (b0.type == RigidBody::DynamicType::Dynamic) {
				// TODO: take mass into account
				MVector dp = inverse_transform(Xv_0_c) * (-inv_I0 * imp_01);
				Vector3f d_translation = dp.tail<3>();
				Vector3f d_rotation = dp.head<3>();

				b0.translation += d_translation;
				float d_rotation_norm = d_rotation.norm();
				if (d_rotation_norm > 1e-5) {
					Quaternionf q_rotation(AngleAxisf(d_rotation_norm, d_rotation / d_rotation_norm));
					b0.rotation = q_rotation * b0.rotation;
				}
			}
			if (b1.type == RigidBody::DynamicType::Dynamic) {
				// TODO:
			}
		}


